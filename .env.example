# Gmail account used to send the daily job digest
GMAIL_USER=your.email@gmail.com

# 16-character Google App Password (NOT your normal Gmail password)
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Display name shown in the recipient's inbox
FROM_NAME=Daily Job Bot

# Free UK Job API keys (configure at least one — both together give the widest coverage)
# 1) Reed.co.uk Jobseeker API (free, instant): https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# 2) Adzuna UK API (free tier, aggregates Totaljobs/CV-Library/Indeed/etc.): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: override recipient for local testing (leave blank to use profile.json)
# TEST_RECIPIENT=your.email@gmail.com
